+
+
+def rename(old: str, new: str) -> Callable[[MutableMapping], None]:
+    """Rename field ``old`` to ``new``; documents without ``old`` are unchanged."""
+    def transform(doc: MutableMapping):
+        if old in doc:
+            doc[new] = doc.pop(old)
+    return transform
